# Copy this file to .env and replace both change-me values.
# Format: username:password@path:permissions
# Avoid using ':', '@', or '|' in the username or password.
DUFS_AUTH=change-me:change-me@/:rw
DUFS_SERVE_PATH=/data
DUFS_BIND=0.0.0.0
DUFS_PORT=5000
DUFS_ALLOW_UPLOAD=true
DUFS_ALLOW_DELETE=true
DUFS_ALLOW_SEARCH=true
DUFS_ALLOW_ARCHIVE=true
DUFS_ALLOW_HASH=true
