  },
  {
    "id": "d66726c08a2e4269",
    "type": "function",
    "z": "40217da19cf34203",
    "name": "记录推送结果（隐藏密钥）",
    "x": 1950,
    "y": 100,
    "wires": [
      [
        "7624e9dcd8ef4758"
      ]
    ],
    "func": "const code = Number(msg.payload && msg.payload.code);\nconst success = msg.statusCode === 200 && code === 200;\nconst result = {sent_at: new Date().toISOString(), success, http_status: msg.statusCode, bark_code: Number.isFinite(code) ? code : null};\nflow.set(\"last_delivery\", result);\nnode.status({fill: success ? \"green\" : \"red\", shape: \"dot\", text: success ? \"提醒已发送\" : \"Bark发送失败\"});\nreturn {payload: result};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
