  {
    "id": "a17934e350a847ec",
    "type": "function",
    "z": "40217da19cf34203",
    "name": "在家 且 电量<40% 且 未插枪",
    "x": 1150,
    "y": 100,
    "wires": [
      [
        "bb9a3971e0e04467"
      ],
      [
        "7624e9dcd8ef4758"
      ]
    ],
    "func": "const v = msg.vehicle || {};\nconst batteryText = String(v.battery ?? \"\").trim();\nconst battery = batteryText === \"\" ? NaN : Number(batteryText);\nconst valid = [\"home\", \"not_home\"].includes(v.location) || (typeof v.location === \"string\" && v.location !== \"unknown\" && v.location !== \"unavailable\" && v.location !== \"\");\nconst batteryValid = Number.isFinite(battery) && battery >= 0 && battery <= 100;\nconst plugValid = [\"已连接\", \"未连接\"].includes(v.plug);\nconst matched = valid && batteryValid && plugValid && v.location === \"home\" && battery < 40 && v.plug === \"未连接\";\nconst result = { checked_at: new Date().toISOString(), location: v.location ?? null, battery: batteryValid ? battery : null, plug: v.plug ?? null, matched, dry_run: msg.dry_run === true, reason: (!valid || !batteryValid || !plugValid) ? \"车辆状态未知，跳过提醒\" : matched ? \"满足充电提醒条件\" : \"不满足提醒条件\" };\nflow.set(\"last_check\", result);\nnode.status({fill: matched ? \"yellow\" : \"green\", shape: \"dot\", text: result.dry_run ? \"测试：\" + result.reason : result.reason});\nif (matched && !result.dry_run) { msg.vehicle.battery = battery; msg.check = result; return [msg, null]; }\nreturn [null, {payload: result}];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
  {
    "id": "bb9a3971e0e04467",
    "type": "function",
    "z": "40217da19cf34203",
    "name": "Bark通知 · han服务器 / BARK_DEVICE",
    "x": 1450,
    "y": 100,
    "wires": [
      [
        "d0cefef9533b4a68"
      ]
    ],
    "func": "const server = String(env.get(\"BARK_SERVER\") || \"\").replace(/^https?:\\/\\//, \"\").replace(/\\/+$/, \"\");\nconst token = env.get(\"BARK_TOKEN\");\nif (!server || !token) { node.error(\"Bark配置缺失\"); return null; }\nconst title = \"车辆充电提醒\";\nconst body = `车辆在家，当前电量 ${msg.vehicle.battery}%，充电枪未连接。请记得插枪充电。`;\nmsg.method = \"GET\";\nmsg.url = `https://${server}/${encodeURIComponent(token)}/${encodeURIComponent(title)}/${encodeURIComponent(body)}?group=Vehicle`;\nmsg.payload = \"\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
