# 完整订阅地址（包含 token 的查询参数也放在这里）
SUBSCRIPTION_URL=https://example.com/api/v1/client/subscribe?token=replace-me
CONFIG_PATH=/etc/ShellCrash/yamls/config.yaml
MIHOMO_CORE=/tmp/ShellCrash/CrashCore
RESTART_COMMAND=systemctl restart shellcrash
SUBSCRIPTION_USER_AGENT=clash.meta
HTTP_TIMEOUT=30
MIN_PROXY_COUNT=1
BACKUP_COUNT=5
# 这些策略组将直接获得全部订阅节点，逗号分隔
UPDATE_GROUPS=🚀 节点选择,🎮 Steam,🤖 ChatGPT
